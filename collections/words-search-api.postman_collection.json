          "name": "Search Words and Get Random Word",
          "request": {
            "name": "Search Words and Get Random Word",
            "description": {
              "content": "Searches the Words API dictionary using letter, sound, part-of-speech, and detail-type filters. Pass random=true to return a single random word matching the filters.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "words",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "letterPattern",
                  "value": "<string>",
                  "description": "Regex pattern matched against the word's letters."
                },
                {
                  "disabled": false,
                  "key": "letters",
                  "value": "<integer>",
                  "description": "Exact letter count."
                },
                {
                  "disabled": false,
                  "key": "lettersMin",
                  "value": "<integer>",
                  "description": "Minimum letter count."
                },
                {
                  "disabled": false,
                  "key": "lettersMax",
                  "value": "<integer>",
                  "description": "Maximum letter count."
                },
                {
                  "disabled": false,
                  "key": "pronunciationPattern",
                  "value": "<string>",
                  "description": "Regex pattern matched against the IPA pronunciation."
                },
                {
                  "disabled": false,
                  "key": "sounds",
                  "value": "<integer>",
                  "description": "Exact phoneme count."
                },
                {
                  "disabled": false,
                  "key": "soundsMin",
                  "value": "<integer>",
                  "description": "Minimum phoneme count."
                },
                {
                  "disabled": false,
                  "key": "soundsMax",
                  "value": "<integer>",
                  "description": "Maximum phoneme count."
                },
                {
                  "disabled": false,
                  "key": "partOfSpeech",
                  "value": "<string>",
                  "description": "Filter by grammatical class."
                },
                {
                  "disabled": false,
                  "key": "hasDetails",
                  "value": "<string>",
                  "description": "Comma-separated detail types the word must have (e.g. \"synonyms"
                },
                {
                  "disabled": false,
                  "key": "random",
                  "value": "<boolean>",
                  "description": "Return a single random word matching the filters."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Results per page (1–100)."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination."
                }
