{
  "opencollection": "1.0.0",
  "info": {
    "name": "Words Categories Examples API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-RapidAPI-Key",
      "value": "{{X-RapidAPI-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Examples",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Word Examples",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://wordsapiv1.p.rapidapi.com/words/:word/examples",
            "params": [
              {
                "name": "word",
                "value": "apple",
                "type": "path",
                "description": "The English word to look up."
              }
            ]
          },
          "docs": "Returns example sentences that use the given word."
        }
      ]
    }
  ],
  "bundled": true
}